# Get these by:
# 1. Visit https://subscription.nillion.com (nilPay)
# 2. Create a testnet keypair, fund it from https://faucet.testnet.nillion.com
# 3. Subscribe to nilDB
# 4. Paste the hex private key below
NIL_BUILDER_PRIVATE_KEY=

# Optional — auto-set if you leave a collection-id file at .hearth-collection-id
HEARTH_COLLECTION_ID=

# Testnet defaults — only override if you're on a different env
NILCHAIN_URL=http://rpc.testnet.nilchain-rpc-proxy.nilogy.xyz
NILAUTH_URL=https://nilauth.sandbox.app-cluster.sandbox.nilogy.xyz
NILDB_NODES=https://nildb-stg-n1.nillion.network,https://nildb-stg-n2.nillion.network,https://nildb-stg-n3.nillion.network
