# --- Vault (nilDB) -----------------------------------------------------------
# Persistent identity. Without this, every restart spins up a new ephemeral
# builder and loses the previous collection. Get a key from the dev portal:
# https://portal.nillion.com
NIL_BUILDER_PRIVATE_KEY=

# Optional — auto-set in .hearth-collection-id on first run
HEARTH_COLLECTION_ID=

# Testnet defaults — only override if you're on a different env
NILDB_NODES=https://nildb-stg-n1.nillion.network,https://nildb-stg-n2.nillion.network,https://nildb-stg-n3.nillion.network

# --- Auto-tagging (nilAI) ----------------------------------------------------
# Optional. If set, hearth augments every memory_append with 2-5 LLM-suggested
# tags via Nillion's private LLM (TEE-based, OpenAI-compatible).
# Get from https://portal.nillion.com (nilAI tab, free tier available).
NILLION_API_KEY=

# Defaults that work out of the box — override only if needed.
NILAI_BASE_URL=https://api.nilai.nillion.network/nuc/v1/
NILAI_MODEL=google/gemma-4-26B-A4B-it
