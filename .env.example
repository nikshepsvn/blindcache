# --- Vault (nilDB) -----------------------------------------------------------
# Persistent identity. Without this, every restart spins up a new ephemeral
# builder and loses the previous collection. Get a hex key from `pnpm keygen`
# or sign up at https://portal.nillion.com.
NIL_BUILDER_PRIVATE_KEY=

# Optional — auto-set in .blindcache-collection-id on first run
BLINDCACHE_COLLECTION_ID=
BLINDCACHE_BUILDER_NAME=blindcache

# Testnet defaults — only override if you're on a different env
NILDB_NODES=https://nildb-stg-n1.nillion.network,https://nildb-stg-n2.nillion.network,https://nildb-stg-n3.nillion.network

# --- nilAI (auto-tag + summarize) --------------------------------------------
# Optional. If set, BlindCache augments every memory_append with 2-5 LLM-suggested
# tags via Nillion's private LLM (TEE-based, OpenAI-compatible) and enables
# memory_summary. Get from https://portal.nillion.com (free tier).
NILLION_API_KEY=

# Defaults that work out of the box — override only if needed.
NILAI_BASE_URL=https://api.nilai.nillion.network/nuc/v1/
NILAI_MODEL=google/gemma-4-26B-A4B-it

# --- HTTP transport (optional, for sharing one warm vault across agents) ----
# When BLINDCACHE_HTTP_PORT is set, the MCP server runs as a local HTTP server
# instead of stdio. BLINDCACHE_HTTP_TOKEN is required (>= 16 chars) — server
# refuses to start with weak auth.
BLINDCACHE_HTTP_PORT=
BLINDCACHE_HTTP_TOKEN=
